{
  "projectId": "4305e5d2-b232-4887-838f-83fa27f215ef",
  "pkg": "ficha-5e-app",
  "globalName": "Ficha5eApp",
  "shape": "package",
  "entry": "./dist/index.js",
  "srcDir": "src/components",
  "tsconfig": "./tsconfig.json",
  "cssEntry": ".design-sync/compiled-styles.css",
  "runtimeFontPrefixes": ["Cambria"],
  "readmeHeader": ".design-sync/conventions.md",
  "libOverrides": {
    "source-kit.mjs": "filter barrel by componentSrcMap nulls + explicit named exports to fix star-re-export collisions (SheetHeader); srcDir=src/components excludes store/useCharacterStore.tsx which pulls in 205K-line ruleService",
    "common.mjs": "add process polyfill to IIFE_IMPORT_META_DEFINE — React 19/Zustand access process directly in browser",
    "bundle.mjs": "fork to: (1) inherit forked common.mjs via relative import (process polyfill in IIFE_IMPORT_META_DEFINE); (2) add dataSizeStubPlugin that stubs public/data/*.json and _references/*.json with a deep-Proxy so components render without bundling 9MB of D&D catalog data"
  },
  "componentSrcMap": {
    "AttributeEditor": null,
    "BackgroundCard": null,
    "BuilderShell": null,
    "BuilderSidebar": null,
    "BuilderStepPanel": null,
    "CharacterSheetPage": null,
    "CharacterSheetPreview": null,
    "CharacterSheetView": null,
    "ContentTabs": null,
    "Dashboard": null,
    "MainContentColumn": null,
    "PersonalDetailsEditor": null,
    "SheetHeader": null,
    "WizardChoiceCard": null
  },
  "overrides": {
    "StatBadge": { "cardMode": "column" },
    "StatFrame": { "cardMode": "column" },
    "SidebarFooter": { "cardMode": "single", "primaryStory": "WithActions" },
    "SidebarGroup": { "cardMode": "single", "primaryStory": "CharacterGroup" },
    "SidebarGroupLabel": { "cardMode": "single", "primaryStory": "Labels" },
    "SidebarHeader": { "cardMode": "single", "primaryStory": "AppHeader" },
    "SidebarInput": { "cardMode": "single", "primaryStory": "SearchInHeader" },
    "SidebarMenuItem": { "cardMode": "single", "primaryStory": "MenuItems" },
    "SidebarMenuSkeleton": { "cardMode": "single", "primaryStory": "LoadingState" },
    "SidebarMenuSub": { "cardMode": "single", "primaryStory": "SpellList" },
    "SidebarMenuSubButton": { "cardMode": "single", "primaryStory": "SubButtons" },
    "SidebarMenuSubItem": { "cardMode": "single", "primaryStory": "SubItems" },
    "SidebarProvider": { "cardMode": "single", "primaryStory": "CharacterNav" }
  }
}
